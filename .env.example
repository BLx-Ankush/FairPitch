# ==============================================================================
# FAIRPITCH ENVIRONMENT CONFIGURATION CONTRACT
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# FairPitch supports two operating modes:
# 1. Production Mode: Multi-tenant PostgreSQL via Supabase (RLS, Auth, SHA-256 Ledger)
# 2. Local Demo Mode: For rapid offline preview with pre-calibrated test scenarios
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE INFRASTRUCTURE (Required for Live / Production Deployment)
# ------------------------------------------------------------------------------
# Get these credentials from your Supabase Project Dashboard -> Project Settings -> API
# Or from local Supabase CLI (`npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (Loss Autopsy Engine)
# ------------------------------------------------------------------------------
# Free API key from Google AI Studio: https://aistudio.google.com/app/apikey
# If omitted, FairPitch automatically activates its deterministic mathematical fallback.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. APPLICATION & PUBLIC VERIFICATION DOMAIN
# ------------------------------------------------------------------------------
# Canonical URL for public ledger verification links and jury invite redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. DEMO & LOCAL TESTING GATING (Strictly Disabled in Production)
# ------------------------------------------------------------------------------
# Set to 'false' in production environments (e.g. Vercel).
# In production, demo cookies and bypass routes are strictly blocked by server guards.
NEXT_PUBLIC_DEMO_MODE=false
DEMO_COOKIE_SECRET=fairpitch_hmac_sha256_demo_secret_key_min_32_characters_here

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Optional - Jury Invites & Results Broadcasts)
# ------------------------------------------------------------------------------
# Transactional delivery via Resend: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=FairPitch <audits@fairpitch.io>

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAYS (Optional)
# ------------------------------------------------------------------------------
# FairPitch natively supports direct-to-organizer P2P UPI payments (0% platform fee)
# with 12-digit bank UTR matching out of the box.
# If you wish to offer card/netbanking via Razorpay, configure keys below:
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
